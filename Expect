import csv

# Read both CSV files into sets
with open('path/to/first_file.csv', 'r') as file1:
    reader1 = csv.reader(file1)
    file1_rows = set(tuple(row) for row in reader1)  # Convert each row to a tuple for set comparison

with open('path/to/second_file.csv', 'r') as file2:
    reader2 = csv.reader(file2)
    file2_rows = set(tuple(row) for row in reader2)

# Find the difference: rows in file2 but not in file1
difference = file2_rows - file1_rows

# Write the difference to a new CSV file
with open('path/to/difference_file.csv', 'w', newline='') as diff_file:
    writer = csv.writer(diff_file)
    writer.writerows(difference)

# Show the result (optional)
for row in difference:
    print(row)
